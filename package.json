{
  "name": "node-red-complete-guide",
  "private": true,
  "type": "module",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "npm run start --workspace frontend",
    "dev:api": "npm run dev --workspace backend",
    "demo:api": "npm run demo --workspace backend",
    "build": "npm run build --workspace frontend",
    "test": "node --test tests/*.test.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "cms:setup": "node --env-file=.env cms/bootstrap.mjs",
    "check:content": "node scripts/check-content.mjs"
  },
  "engines": { "node": ">=22.12.0 <25" }
}
